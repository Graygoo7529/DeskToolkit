{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskTodo",
  "version": "0.1.0",
  "identifier": "com.desktoolkit.desktodo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1442",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskTodo - Notes",
        "width": 1260,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Local-first markdown notes and todos",
    "longDescription": "DeskTodo is a calm desktop workspace for markdown notes and actionable todos.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
